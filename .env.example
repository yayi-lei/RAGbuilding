# ============================================================
# 复制成 .env 后使用：cp .env.example .env && chmod 600 .env
# 所有 change-me-* 都必须换成你自己生成的长随机串，不要用默认值。
# ============================================================

# ---- 服务对外绑定地址 ----
# 0.0.0.0     = 局域网可访问（请确保 KB_TOKEN 足够强）
# 127.0.0.1   = 只本机，外部访问需自己加反向代理
# <内网IP>    = 只绑某张网卡，例如 Tailscale / 内网地址
BIND_IP=127.0.0.1

# ---- Qdrant 向量库 ----
QDRANT_API_KEY=change-me-to-a-long-random-string

# ---- 集合与向量维度（必须和嵌入模型一致，改维度会需要重建库）----
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
COLLECTION=office_docs

# ---- 管理台登录（网页端账号密码）----
KB_ADMIN_USER=admin
KB_ADMIN_PASS=change-me-to-a-strong-password

# ---- 接口令牌（MCP / HTTP API 的 Bearer token）----
KB_TOKEN=change-me-to-another-long-random-string

# ============================================================
# 嵌入后端：本地 Ollama 优先，Cloudflare 兜底
# ============================================================
EMBED_PRIORITY=local

# 本地 Ollama 地址
#   容器内访问宿主机上的 Ollama -> http://host.docker.internal:11434
#   访问另一台机器          -> http://<该机地址>:11434
OLLAMA_URL=http://host.docker.internal:11434

# 主备切换的熔断参数
EMBED_FAIL_THRESHOLD=3
EMBED_COOLDOWN=120

# ---- Cloudflare Workers AI 兜底（不填则只走本地）----
# account_id 在 dash.cloudflare.com 右侧栏；API Token 见 README 的申请步骤
CF_ENABLED=1
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/qwen/qwen3-embedding-0.6b
CF_TIMEOUT=45

# ============================================================
# 扫描件 OCR（可选，不填则跳过 OCR，其他格式照常）
# 需要一个 OpenAI 兼容的多模态网关，例如 vLLM / one-api / 自建
# ============================================================
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
OCR_MIN_CHARS=50
OCR_DPI=150
